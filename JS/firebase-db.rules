{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "gunky_chat": {
      ".read": true,
      "$messageId": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'author', 'text', 'color', 'style', 'timestamp'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "style": {
          ".validate": "newData.val() === 'normal' || newData.val() === 'bold' || newData.val() === 'italic'"
        },
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        "$connectionId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true"
        }
      }
    },
    "site_text": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['mood', 'working_on', 'footer', 'transmission'])",
      "mood": {
        ".validate": "newData.isString() && newData.val().length <= 80"
      },
      "working_on": {
        ".validate": "newData.isString() && newData.val().length <= 300"
      },
      "footer": {
        ".validate": "newData.isString() && newData.val().length <= 300"
      },
      "transmission": {
        ".validate": "newData.isString() && newData.val().length <= 300"
      }
    },
    "media_metadata": {
      ".read": true,
      "$category": {
        "$itemId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && ($category === 'comics' || $category === 'drawings')",
          ".validate": "newData.hasChildren(['title', 'url', 'thumbnail']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 160 && newData.child('url').isString() && newData.child('url').val().length <= 2048 && newData.child('thumbnail').isString() && newData.child('thumbnail').val().length <= 2048 && (!newData.child('uploadedAt').exists() || newData.child('uploadedAt').isNumber())"
        }
      }
    },
    "visit_count": {
      ".read": true,
      ".write": "auth != null && newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))",
      ".validate": "newData.isNumber() && newData.val() >= 0"
    },
    "guestbook": {
      ".read": true,
      ".indexOn": ["ts"],
      "$entryId": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'msg', 'ts'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "msg": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
